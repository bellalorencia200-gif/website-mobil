// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User{
  id        String    @id
  username  String @unique
  password  String
  email     String @unique
  fullName  String
  noHp      String?
  role String @default("user")
}

model Category {
id String @id
name String
icon String
mobils Mobil[]
}

model Mobil {
id       String @id
nama     String
deskripsi String
tahun     Int
harga     Int
stok      Int
images     String[]
categoryId String
merek String @default("Lainnya")
kilometer Int @default(0)
transmisi String @default("Manual")
bahanBakar String @default("Bensin")
kapasitasMesin Int @default(0)
warna String @default("-")
isPromo Boolean @default(false)
category   Category  @relation(fields: [categoryId], references: [id])
}

model Settings {
  id             String   @id @default("main")
  alamat         String?
  mapEmbedUrl    String?
  jamOperasional String?
  whatsapp       String?
  updatedAt      DateTime @updatedAt
}

model Testimoni {
  id            String   @id @default(cuid())
  namaPelanggan String
  komentar      String
  rating        Int      @default(5)
  fotoUrl       String?
  mobilDibeli   String?
  lokasi        String?
  aktif         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
